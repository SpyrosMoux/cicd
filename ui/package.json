{
  "name": "flowforge-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test:config": "node --test tests/local-development.test.mjs",
    "test:browser": "node tests/run.mjs",
    "test:browser:dev": "node tests/run.mjs --dev --grep 'newest first|empty installation|API outage'"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/amqplib": "0.10.8",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "amqplib": "2.3.1",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
