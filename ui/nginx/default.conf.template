# Preserve the original escaped run ID when routing saved-log reads.
map $request_uri $saved_log_path {
    default "";
    ~^/api/logs/([^/?]+)$ /app/cicd/logs/$1;
}

map $request_uri $live_log_path {
    default "";
    ~^/api/logs/ws/([^/?]+)$ /app/cicd/logs/ws/$1;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    resolver 127.0.0.11 valid=10s ipv6=off;

    add_header X-Content-Type-Options nosniff always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

    location = /api/runs {
        limit_except GET { deny all; }
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass $api_upstream/app/cicd/api/runs;
        proxy_connect_timeout 3s;
        proxy_read_timeout 8s;
    }

    location /api/logs/ws/ {
        limit_except GET { deny all; }
        if ($live_log_path = "") { return 404; }
        set $logcollector_upstream "${LOGCOLLECTOR_UPSTREAM}";
        proxy_pass $logcollector_upstream$live_log_path;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # Preserve same-origin Host/Origin for the collector's existing origin check.
        proxy_set_header Host $http_host;
        proxy_connect_timeout 3s;
        # An idle text-only stream has no heartbeat. The UI reconciles and reconnects.
        proxy_read_timeout 60s;
    }

    location /api/logs/ {
        limit_except GET { deny all; }
        if ($saved_log_path = "") { return 404; }
        set $logcollector_upstream "${LOGCOLLECTOR_UPSTREAM}";
        proxy_pass $logcollector_upstream$saved_log_path;
        proxy_connect_timeout 3s;
        proxy_read_timeout 8s;
    }

    location /api/ { return 404; }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }

    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
