# syntax=docker/dockerfile:1
# Node 24.15.0 Alpine.
FROM node@sha256:d1b3b4da11eefd5941e7f0b9cf17783fc99d9c6fc34884a665f40a06dbdfc94f AS build
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY ui/ ./
RUN npm run build

# Unprivileged Nginx 1.28.0 Alpine.
FROM nginxinc/nginx-unprivileged@sha256:c97ff0bf7cbae369953c6da1232ec14ad9f971d66360c5698db0856a4cd657a0
ENV API_UPSTREAM=http://api:8080
ENV LOGCOLLECTOR_UPSTREAM=http://logcollector:8081
ENV NGINX_ENVSUBST_FILTER=^(API_UPSTREAM|LOGCOLLECTOR_UPSTREAM)$
COPY ui/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /ui/dist /usr/share/nginx/html
USER 101:101
EXPOSE 8080
